<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.dinamo541</groupId>
        <artifactId>idearm-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>idearm-toolchain-nasm</artifactId>
    <name>IDEARM NASM Toolchain</name>
    <description>L4 Infrastructure: NASM and GNU Linker adapters, diagnostics, and 32/64-bit target support.</description>
    <dependencies>
        <dependency>
            <groupId>io.github.dinamo541</groupId>
            <artifactId>idearm-domain</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>nasm-without-javafx</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration><rules><bannedDependencies>
                            <excludes><exclude>org.openjfx:*</exclude></excludes>
                            <message>NASM toolchain infrastructure must not depend on JavaFX (ADR-007).</message>
                        </bannedDependencies></rules></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
