    ],
    "example": "; Desplazamiento logico a la derecha: division sin signo entre 2\n; Estado inicial: AX = 000Ah (10 decimal), CF = 0, OF = 0\nmov ax, 10\nshr ax, 1\n; Estado final: AX = 0005h (5 decimal), CF = 0, OF = 0, ZF = 0, SF = 0\n; Verificacion: ASSEMBLED",
    "flags": {
      "O": "MODIFIED",
      "D": "UNAFFECTED",
