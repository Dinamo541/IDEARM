      "src.irvine.5e-es#cap7:desplazamientos"
    ],
    "recognizedBy": [
      "MASM",
      "TASM",
      "NASM"
    ],
    "pitfalls": [
      "SHR inserta siempre ceros por la izquierda (desplazamiento logico); no conserva el signo en numeros negativos.",
      "Para division entera de numeros con signo debe emplearse SAR, no SHR.",
      "Si la cuenta es 0, las banderas permanecen inalteradas.",
      "Si la cuenta es mayor a 1, OF queda indefinida; cuando la cuenta es 1, OF recibe el bit mas significativo original del operando."
    ],
    "counterExamples": [
      "mov ax, -4\nshr ax, 1 ; AX = 7FFEh (32766 positivo), se perdio el signo negativo. Debe usarse SAR para preservar signo."
    ],
