          { "flag": "OF", "effect": "MODIFIED", "condition": "count == 1", "note": "OF recibe el MSB del operando original" },
          { "flag": "SF", "effect": "CLEARED", "note": "siempre 0 porque el bit superior queda en cero" },
          { "flag": "ZF", "effect": "MODIFIED" },
