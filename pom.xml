<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.dinamo541</groupId>
    <artifactId>idearm-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>IDEARM</name>
    <description>IDE specialized in x86 Assembly.</description>

    <!--
        N-layer architecture (docs/technical-plan.md §9, ADR-007):
        L1 Presentation -> L2 Application -> L3 Domain <- L4 Infrastructure.
        Modules are added when they get their first class.
    -->
    <modules>
        <!-- L3 Domain -->
        <module>idearm-domain</module>
        <module>idearm-language</module>
        <!-- L2 Application -->
        <module>idearm-application</module>
        <!-- L4 Infrastructure -->
        <module>idearm-infrastructure</module>
        <module>idearm-toolchain-dos</module>
        <module>idearm-emu8086</module>
        <module>idearm-toolchain-nasm</module>
        <!-- L1 Presentation -->
        <module>idearm-cli</module>
        <module>idearm-app</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>25.0.2</javafx.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <junit.version>5.11.4</junit.version>
        <jackson.version>2.18.6</jackson.version>
        <archunit.version>1.4.1</archunit.version>
        <richtextfx.version>0.11.7</richtextfx.version>
        <flowless.version>0.7.4</flowless.version>
        <idearm.allowJavafx>false</idearm.allowJavafx>
        <excludedGroups>requires-tasm,requires-masm,requires-nasm,requires-dosbox</excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.mkpaz</groupId>
                <artifactId>atlantafx-base</artifactId>
                <version>${atlantafx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.fxmisc.richtext</groupId>
                <artifactId>richtextfx</artifactId>
                <version>${richtextfx.version}</version>
            </dependency>
            <dependency>
                <groupId>org.fxmisc.flowless</groupId>
                <artifactId>flowless</artifactId>
                <version>${flowless.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                    <configuration>
                        <excludedGroups>${excludedGroups}</excludedGroups>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.openjfx</groupId>
                    <artifactId>javafx-maven-plugin</artifactId>
                    <version>0.0.8</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>layers-without-javafx</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <skip>${idearm.allowJavafx}</skip>
                            <rules>
                                <bannedDependencies>
                                    <excludes><exclude>org.openjfx:*</exclude></excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>JavaFX is allowed only in Presentation modules (ADR-007).</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                    <message>IDEARM requires JDK 25 or newer (JavaFX 25 needs JDK 23+).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>local-tools</id>
            <properties><excludedGroups>requires-masm</excludedGroups></properties>
        </profile>
    </profiles>
</project>
